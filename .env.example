APP_NAME=StrategyBuzzer
APP_ENV=local
APP_KEY=base64:your_app_key_here
APP_DEBUG=true

# --- Game Server JWT ---
# Shared secret for JWT authentication between Laravel and Game Server
# If not set, falls back to APP_KEY (decoded from base64)
GAME_SERVER_JWT_SECRET=your_shared_jwt_secret_here

# --- Question API admin JWT (#94) ---
# HS256 secret used by App\Services\QuestionApi\QuestionApiClient (Laravel)
# to mint short-lived per-call tokens accepted by question-api.js on the
# /generate-master-question and /generate-image-question admin endpoints.
# Replaces the old static MASTER_API_ADMIN_TOKEN shared secret. If left
# empty, the question-api falls back to GAME_SERVER_JWT_SECRET so a
# single-secret deploy keeps working; both ends require >= 16 chars.
QUESTION_API_JWT_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_here
DB_USERNAME=your_username_here
DB_PASSWORD=your_password_here

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=strategybuzzer.com

# --- OAuth Google ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://strategybuzzer.com/auth/google/callback

# --- OAuth Facebook ---
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
FACEBOOK_REDIRECT_URI=https://strategybuzzer.com/auth/facebook/callback

# Sanctum
SANCTUM_STATEFUL_DOMAINS=strategybuzzer.com,www.strategybuzzer.com,vps.strategybuzzer.com

# Vues compilées
VIEW_COMPILED_PATH=storage/framework/views

# Mail local
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_FROM_ADDRESS=no-reply@strategybuzzer.local
MAIL_FROM_NAME="StrategyBuzzer"

# --- AI Router (Question API, bank refill only) ---
# Multi-provider, multi-key router used by the bank-refill worker (#82).
# NEVER on the live-match critical path. Each provider supports one or more
# comma-separated keys; the legacy single-key vars stay supported.
#
# Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3
#
# OpenAI (secondary, takes over when all Gemini keys are quarantined)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_KEYS=key1,key2,key3
#
# Anthropic (tertiary, extra resilience — engages when both Gemini and OpenAI
# are exhausted; opt in by appending it to AI_PROVIDER_ORDER below)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_KEYS=key1,key2,key3
#
# Optional tuning:
# AI_PROVIDER_ORDER=gemini,openai,anthropic   # comma-separated failover order
# AI_QUARANTINE_SECONDS=60                    # how long to park a key after a 429/401/403
