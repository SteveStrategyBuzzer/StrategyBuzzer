# ===============================
# Security hardening
client_secret*.json
*.p12
*.pem
*.pfx
*.crt
*.key
*.der
*.keystore
*.jks

# Environment
.env
.env.*
!.env.example

# Laravel
/vendor/
/bootstrap/cache/*.php
/node_modules/
public/hot
public/storage
/storage/*.key

# Logs / cache / sessions / views
/storage/logs/*.log
/storage/logs/*.gz
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/debugbar/*
/storage/app/private/*

# Garder les dossiers Laravel nécessaires
!/storage/app/.gitignore
!/storage/framework/.gitignore
!/storage/logs/.gitignore

# Node / TS / builds
apps/game-server/node_modules/
apps/game-server/dist/
/dist/
**/dist/
**/*.tsbuildinfo

# si tsc a déjà généré dans src par erreur
packages/*/src/*.js
packages/*/src/*.js.map
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map

# Temporary / backup files
*.bak
*.bak.*
*.backup
*.old
*.tmp

# backup local nettoyage
.backup_cleaning_2026-03-10/

# dumps locaux (never commit DB exports to source control)
export_strategybuzzer.sql
Cloud_SQL_Export*.sql
*_export.sql
*.dump.sql

# Migration exports temporaires VM→Neon (jamais commiter, supprimer après import)
database/migration_exports/

# Firebase credentials
storage/app/firebase-credentials.json

.trash_root_files_2026-03-10/
attached_assets/Pasted-Je-travaille-sur-un-projet-appel-StrategyBuzzer-un-jeu-_1773518592336.txt

# backups
*.save
*.bak_*
# Sauvegardes DB locales (pg_dump) — jamais commiter (données joueurs)
database/backups/
firebase/firebase-service-account.json
dump.rdb

# Playwright test artifacts
tests/e2e/playwright-report/
tests/e2e/test-results/
playwright-report/
test-results/
/.phpunit.result.cache

/.phpunit.cache/
