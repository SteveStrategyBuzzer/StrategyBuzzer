
# --- Security hardening (ajouts StrategyBuzzer) ---
client_secret*.json
*.p12
*.pem
*.pfx
*.crt
*.key
*.der
*.keystore
*.jks

# Logs et caches volumineux
storage/logs/*.log
storage/logs/*.gz
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# .env déjà ignoré par défaut mais on redéclare par sûreté
.env
.env.*
!.env.example

# Firebase credentials (never commit)
storage/app/firebase-credentials.json
export_strategybuzzer.sql

# ===============================
# Laravel Core (obligatoire)
# ===============================
/vendor/
/bootstrap/cache/*.php

# ===============================
# Node / Game Server
# ===============================
/node_modules/
apps/game-server/node_modules/
apps/game-server/dist/
/dist/

# ===============================
# Fichiers temporaires / backup
# ===============================
*.bak
*.backup
*.old
*.tmp


# backups
*.bak.*
*.bak
*.tmp

# node/ts build
**/dist/
**/*.tsbuildinfo

# si tsc a déjà généré des fichiers dans src par erreur
packages/*/src/*.js
packages/*/src/*.js.map
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map
