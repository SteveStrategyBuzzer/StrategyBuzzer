{
  "name": "strategybuzzer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm -w @strategybuzzer/shared run build",
    "build:game-engine": "npm -w @strategybuzzer/game-engine run build",
    "build:game-server": "npm -w @strategybuzzer/game-server run build",
    "build:all": "npm run build:shared && npm run build:game-engine && npm run build:game-server",
    "dev:game-server": "npm -w @strategybuzzer/game-server run dev",
    "start:game-server": "npm -w @strategybuzzer/game-server run start",
    "seed:check": "node scripts/seed/check_seed_coverage.mjs",
    "seed:generate": "node scripts/seed/generate_seed_pool.mjs",
    "test:e2e:duo-join": "node tests/e2e/duo-join-room.test.js",
    "test:e2e:duo-join-browser": "node tests/e2e/duo-join-room.browser.spec.js",
    "test:e2e:master-join-browser": "node tests/e2e/master-join-room.browser.spec.js",
    "test:e2e:league-individual-join-browser": "node tests/e2e/league-individual-join-room.browser.spec.js",
    "test:providers:anthropic-contract": "node tests/providers/anthropic.contract.test.js",
    "test:question-api:admin-jwt": "node --test tests/question-api/admin-jwt.test.js",
    "test:security:admin-jwt-replay": "node tests/security/admin-jwt-replay.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.31.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "laravel-vite-plugin": "^2.0.1",
    "playwright": "^1.59.1",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  }
}
